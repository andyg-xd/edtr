<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Merged into the generated Info.plist by the Tauri bundler.

  Declares Edtr's document types here (NOT via tauri.conf.json `fileAssociations`)
  because a FOLDER (public.folder) association is required so that dropping a
  folder on the Dock/app icon fires `RunEvent::Opened` — and the ext-based
  `fileAssociations` config cannot express a folder UTI. Keeping all document
  types in one place avoids array-merge (append-vs-replace) ambiguity for
  `CFBundleDocumentTypes`. The md/html entries reproduce exactly what
  `fileAssociations` previously generated.
-->
<plist version="1.0">
<dict>
	<!--
	  Modern macOS apps carry CFBundleIconName alongside CFBundleIconFile;
	  Tauri emits only the latter. Adding it here rather than in
	  tauri.conf.json because this file is already the one place this project
	  merges Info.plist keys, and splitting them across two mechanisms is how
	  they drift.

	  ⚠️ CFBundleIconName normally names an image set in an ASSET CATALOG, and
	  Edtr has none — it ships icon.icns via CFBundleIconFile. This was tried
	  during 6a and observed not to break anything, but "observed not to break"
	  is weaker than proven. If the icon ever looks wrong in Finder, the Dock
	  or About, THIS KEY IS THE FIRST SUSPECT and removing it is the first
	  thing to try. It is on 6b's install walk for that reason.

	  It does NOT fix the Finder list-view plate. That is timeboxed and closed
	  with six refuted hypotheses in PLAN.md — do not reopen it here.
	-->
	<key>CFBundleIconName</key>
	<string>icon</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Markdown Document</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Default</string>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>md</string>
				<string>markdown</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>HTML Document</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Default</string>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>html</string>
				<string>htm</string>
			</array>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.html</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Folder</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.folder</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
