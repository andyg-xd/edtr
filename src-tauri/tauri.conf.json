{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Edtr",
  "version": "1.0.2",
  "identifier": "com.andresgarcia.edtr",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Edtr",
        "width": 800,
        "height": 600,
        "minWidth": 800,
        "minHeight": 320
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' https: http:",
        "img-src": "'self' asset: http://asset.localhost https: http: data: blob:",
        "font-src": "'self' asset: http://asset.localhost https: http: data:",
        "media-src": "'self' asset: http://asset.localhost https: http: data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval' http://localhost:1420",
        "style-src": "'self' 'unsafe-inline' https: http:",
        "img-src": "'self' asset: http://asset.localhost https: http: data: blob:",
        "font-src": "'self' asset: http://asset.localhost https: http: data:",
        "media-src": "'self' asset: http://asset.localhost https: http: data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost ws://localhost:1420 http://localhost:1420",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true
    }
  }
}
